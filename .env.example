# Valores para rodar fora do Docker (venv local). Ao rodar via `docker compose up`,
# DATABASE_URL e OLLAMA_BASE_URL são sobrescritos automaticamente para apontar
# para os serviços `db` e `ollama` da rede do compose — não precisa editar aqui.
DATABASE_URL=postgresql+asyncpg://agentjob:agentjob@localhost:5432/agentjob

# Porta do Postgres publicada no host pelo docker-compose (só o compose lê isso,
# não é usado pela aplicação). Padrão 5434 pra não bater com outro Postgres local.
DB_HOST_PORT=5434

# ollama | anthropic
MATCHER_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# qwen2.5:3b por padrão: cabe inteiro em ~4GB de VRAM (100% GPU, rápido). Se sua
# GPU tem mais memória (ou você roda em CPU mesmo), qwen2.5:7b extrai um pouco
# melhor, mas é bem mais lento sem VRAM suficiente pra caber o modelo inteiro.
OLLAMA_MODEL=qwen2.5:3b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Origens do frontend com permissão de CORS (separadas por vírgula).
# Padrão cobre localhost:3000/5173; ajuste se o frontend rodar em outro host.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
